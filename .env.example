# amp-mcp-server environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- AMP connection (required) ---

# Base URL of your AMP install (no trailing slash)
AMP_URL=https://amp.example.local

# AMP admin username
AMP_USERNAME=admin

# AMP password (or remembered-token; see @neuralnexus/ampapi docs)
AMP_PASSWORD=changeme

# --- Tool gating (optional) ---

# Set to "true" to enable mutating tools (start/stop/restart/send-console-command).
# Default off to prevent accidental destructive calls.
AMP_ALLOW_WRITES=false

# --- MCP transport (optional) ---

# "stdio" (default) for direct local use, "http" for Docker/remote.
MCP_TRANSPORT=stdio

# Port for HTTP transport. Ignored when MCP_TRANSPORT=stdio.
MCP_PORT=3000

# Bind address for HTTP transport.
#   127.0.0.1 (default outside Docker) = loopback only
#   0.0.0.0 = all interfaces (required inside Docker; combine with auth or
#            MCP_ALLOWED_HOSTS — server refuses to start otherwise)
MCP_HOST=127.0.0.1

# Comma-separated allow-list for the Host header (DNS rebinding protection).
# Required when MCP_HOST is 0.0.0.0/:: and MCP_AUTH_MODE=none, unless
# MCP_ALLOW_INSECURE=true.
# Example: amp-mcp.example.com,localhost
MCP_ALLOWED_HOSTS=

# Comma-separated allow-list for the Origin header (browser-client check).
# When set, requests with a non-matching Origin get 403. Requests with no
# Origin (server-to-server, CLI tools) are allowed through. Leave empty to
# skip the check.
# Example: https://claude.ai,https://app.example.com
MCP_ALLOWED_ORIGINS=

# Trust proxy hops for Express. Set when running behind nginx/Caddy/Traefik
# so req.ip and rate-limiting see the real client IP. Values accepted:
# https://expressjs.com/en/guide/behind-proxies.html (e.g. "1", "loopback",
# "uniquelocal", a CIDR list).
MCP_TRUST_PROXY=

# Escape hatch: skip the "exposed without auth" startup guard. Don't.
MCP_ALLOW_INSECURE=false

# Rate limit on /mcp. Set 0 to disable.
MCP_RATE_LIMIT=120
MCP_RATE_WINDOW_MS=60000

# --- Authentication (HTTP transport only; stdio ignores these) ---

# none   = no auth (default; safe only for stdio or localhost-only HTTP)
# bearer = static Authorization: Bearer <MCP_AUTH_TOKEN>
# oauth  = OAuth 2.1 resource server (validates JWTs from your AS)
MCP_AUTH_MODE=none

# Canonical external URL of this MCP server, no trailing slash.
# REQUIRED when MCP_AUTH_MODE=oauth — used as the OAuth resource identifier
# and the expected JWT `aud` claim. Must match exactly what clients call.
# e.g. https://amp-mcp.example.com
MCP_PUBLIC_URL=

# --- Bearer mode ---

# Comma-separated list of accepted bearer tokens. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- OAuth mode ---

# OAuth 2.1 authorization server issuer URL (e.g. Keycloak realm root,
# Auth0 tenant, Authentik provider). Must support OIDC discovery at
# {issuer}/.well-known/openid-configuration unless MCP_OAUTH_JWKS_URL is set.
MCP_OAUTH_ISSUER=

# Optional: override the expected JWT audience. Defaults to MCP_PUBLIC_URL.
MCP_OAUTH_AUDIENCE=

# Optional: skip OIDC discovery and use this JWKS URL directly.
MCP_OAUTH_JWKS_URL=

# Optional: comma-separated scopes required on every request.
MCP_OAUTH_REQUIRED_SCOPES=

# --- Logging (optional) ---

# pino log level: trace | debug | info | warn | error | fatal
# All logs go to stderr (stdout is reserved for MCP JSON-RPC in stdio mode).
LOG_LEVEL=info
