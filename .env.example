# amp-mcp-server environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- AMP connection (required) ---

# Base URL of your AMP install (no trailing slash)
AMP_URL=https://amp.example.local

# AMP admin username
AMP_USERNAME=admin

# AMP password (or remembered-token; see @neuralnexus/ampapi docs)
AMP_PASSWORD=changeme

# --- Tool gating (optional) ---

# Set to "true" to enable mutating tools (start/stop/restart/send-console-command).
# Default off to prevent accidental destructive calls.
AMP_ALLOW_WRITES=false

# --- MCP transport (optional) ---

# "stdio" (default) for direct local use, "http" for Docker/remote.
MCP_TRANSPORT=stdio

# Port for HTTP transport. Ignored when MCP_TRANSPORT=stdio.
MCP_PORT=3000
